# cocarr-identity-service — environment
NODE_ENV=production
PORT=3050

# --- Identity database (MySQL) ----------------------------------------------
DB_HOST=your-mysql-host
DB_PORT=3306
DB_NAME=cocarr_iam
DB_USER=cocarr
DB_PASS=change-me

# --- CORS --------------------------------------------------------------------
CORS_ORIGINS=https://admin.cocarr.com,https://workspace.cocarr.com

# --- Firebase (auth verification + password links) ---------------------------
# JSON string (one line) or a path. Unset => dev mode (verification disabled).
ADMIN_SERVICE_ACCOUNT=

# --- Sessions ----------------------------------------------------------------
SESSION_TTL_DAYS=30

# --- Dev-only auth escape hatch (NEVER true in production) --------------------
AUTH_DISABLED=false
